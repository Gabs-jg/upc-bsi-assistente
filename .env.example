# Região AWS. Configure credenciais pelo perfil AWS CLI ou pelo CloudShell.
AWS_DEFAULT_REGION=us-east-2

# Preencha antes de calibrar o juiz.
# Para avaliação com juiz homogêneo (mesmo modelo), use --allow-same-judge no avaliador.
BEDROCK_AGENT_MODEL=qwen.qwen3-next-80b-a3b
BEDROCK_JUDGE_MODEL=qwen.qwen3-next-80b-a3b

# URL do proxy HTTP (obtida no API Gateway após o deploy)
UPC_API_URL=https://ID.execute-api.us-east-2.amazonaws.com/perguntar

# Opcional: Se for usar OpenAI como juiz independente
# OPENAI_API_KEY=
